---
import { getCollection } from "astro:content"
import HomeCarousel from "../components/home-carousel"
import { siteConfig } from "../../config/site"
import SiteLayout from "../layouts/SiteLayout.astro"

const [pageEntries, carouselEntries] = await Promise.all([
  getCollection("pages"),
  getCollection("carousel"),
])
const page = pageEntries.find(({ data }) => data.route.path === "/404")
if (!page) throw new Error("Missing 404 page metadata in publicPage.yaml")
const slides = carouselEntries
  .filter(({ data }) => data.for === "homePage")
  .map(({ data }) => data)
---

<SiteLayout
  title={page.data.siteTitle || page.data.route.title.cn || "404"}
  description={page.data.description || "404"}
  heading={page.data.title || page.data.route.title.cn || "404"}
  subtitle={page.data.subTitle || undefined}
>
  <div class="mx-auto max-w-3xl">
    <img
      src={siteConfig.pages.notFoundImage}
      alt={`${page.data.route.title.cn || "404"} 页面不存在`}
      class="mx-auto max-h-80"
    />
    <div
      class="my-8 rounded-lg border border-blue-200 bg-blue-50 p-5 text-center text-blue-950 dark:border-blue-800 dark:bg-blue-950 dark:text-blue-100"
      role="status"
    >
      <h2 class="text-xl font-semibold">
        {siteConfig.pages.notFoundMessage}
        <a href="/">{siteConfig.pages.notFoundLinkLabel}</a>
        {siteConfig.pages.notFoundMessageSuffix}
      </h2>
    </div>
    <HomeCarousel client:load slides={slides} />
  </div>
</SiteLayout>
