---
import { getCollection } from "astro:content"
import ArticleTimeline, {
  type ArticleListItem,
} from "../../components/article-timeline"
import { siteConfig } from "../../../config/site"
import SiteLayout from "../../layouts/SiteLayout.astro"
import { articleExcerpt, formatArticleDate, sortArticles } from "../../articles"

const [pageEntries, articleEntries] = await Promise.all([
  getCollection("pages"),
  getCollection("articles", ({ data }) => !data.draft),
])
const page = pageEntries.find(({ data }) => data.route.path === "/articles")
if (!page) throw new Error("Missing articles page metadata in publicPage.yaml")
const articles: ArticleListItem[] = sortArticles(articleEntries).map(
  article => ({
    id: article.id,
    title: article.data.title,
    author: article.data.author || siteConfig.brand.name,
    date: formatArticleDate(article.data.date),
    href: `/articles/${article.id}`,
    description: articleExcerpt(article, 140),
  }),
)
---

<SiteLayout
  title={
    page.data.siteTitle || page.data.route.title.cn || siteConfig.site.name
  }
  description={page.data.description || siteConfig.site.description}
  heading={page.data.title || page.data.route.title.cn || siteConfig.site.name}
  subtitle={page.data.subTitle || undefined}
>
  <section aria-label="博文列表">
    <ArticleTimeline articles={articles} />
  </section>
</SiteLayout>
