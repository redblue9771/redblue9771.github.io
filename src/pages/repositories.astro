---
import { getCollection } from "astro:content"
import GithubRepositories from "../components/github-widgets"
import { integrations } from "../../config/integrations"
import { siteConfig } from "../../config/site"
import SiteLayout from "../layouts/SiteLayout.astro"

const pages = await getCollection("pages")
const page = pages.find(({ data }) => data.route.path === "/repositories")
if (!page)
  throw new Error("Missing repositories page metadata in publicPage.yaml")
---

<SiteLayout
  title={
    page.data.siteTitle || page.data.route.title.cn || siteConfig.site.name
  }
  description={page.data.description || siteConfig.site.description}
  heading={page.data.title || page.data.route.title.cn || siteConfig.site.name}
  subtitle={page.data.subTitle || undefined}
>
  <GithubRepositories client:load username={integrations.githubUsername} />
</SiteLayout>
