---
import { getCollection } from "astro:content"
import HomeCarousel from "../components/home-carousel"
import { HomeGithubWidget } from "../components/github-widgets"
import { integrations } from "../../config/integrations"
import { siteConfig } from "../../config/site"
import SiteLayout from "../layouts/SiteLayout.astro"
import { articleExcerpt, sortArticles } from "../articles"

const [pageEntries, carouselEntries, articleEntries] = await Promise.all([
  getCollection("pages"),
  getCollection("carousel"),
  getCollection("articles", ({ data }) => !data.draft),
])
const homePage = pageEntries.find(({ data }) => data.route.path === "/")
if (!homePage) throw new Error("Missing homepage metadata in publicPage.yaml")
const slides = carouselEntries
  .filter(({ data }) => data.for === "homePage")
  .map(({ data }) => data)
const latestArticles = sortArticles(articleEntries).slice(
  0,
  siteConfig.profile.latestArticleCount,
)
const formatHomeArticleDate = (date?: Date) =>
  date
    ? new Intl.DateTimeFormat("en-US", {
        month: "long",
        day: "2-digit",
        year: "numeric",
        timeZone: "UTC",
      })
        .format(date)
        .replace(", ", ",")
    : ""
---

<SiteLayout
  title={homePage.data.siteTitle || siteConfig.site.name}
  description={homePage.data.description || siteConfig.site.description}
  heading={homePage.data.title || siteConfig.site.name}
  subtitle={homePage.data.subTitle || undefined}
  fullWidth
>
  <HomeCarousel client:load slides={slides} />

  <img
    src={siteConfig.profile.avatar.src}
    alt={siteConfig.profile.avatar.alt}
    class="mx-auto w-64 px-3"
  />

  <section
    class="mb-24 w-full bg-cover bg-fixed bg-center px-4 pb-12 pt-8 text-white shadow-xl"
    style={`background-image: url('${siteConfig.profile.backgroundImage}')`}
  >
    <div class="mx-auto max-w-[1024px] text-center">
      <h2 class="text-3xl font-semibold">{siteConfig.profile.greeting}</h2>
      <p class="font-slogan mt-2 text-2xl">
        {siteConfig.profile.greetingChinese}
      </p>
    </div>
    <div class="mx-auto grid w-full max-w-[1024px] translate-y-16 grid-cols-1 gap-0 md:grid-cols-3">
      <section
        class="min-w-0 min-h-[22.25rem] bg-primary px-[1.4rem] py-4 text-center"
        aria-labelledby="latest-articles-title"
      >
        <h2
          id="latest-articles-title"
          class="mb-4 text-xl font-semibold"
        >
          {siteConfig.profile.latestArticlesTitle}
        </h2>
        {latestArticles.map(article => (
          <a
            href={`/articles/${article.id}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mb-3 block truncate rounded px-2 py-1 text-white no-underline hover:bg-white/10 hover:text-white"
            title={article.data.description || articleExcerpt(article, 100)}
          >
            <span class="block truncate">{article.data.title}</span>
            <small class="block truncate text-white/75">
              {article.data.author || siteConfig.brand.name} -{" "}
              {formatHomeArticleDate(article.data.date)}
            </small>
          </a>
        ))}
      </section>
        <HomeGithubWidget
          client:load
          username={integrations.githubUsername}
          title={siteConfig.profile.projectsTitle}
        />
      <section
        class="min-w-0 min-h-[22.25rem] bg-primary px-[1.4rem] py-4 text-white text-center"
        aria-labelledby="about-title"
      >
        <h2 id="about-title" class="mb-4 text-xl font-semibold">
          {siteConfig.profile.aboutTitle}
        </h2>
        <ul class="space-y-3">
          {siteConfig.profile.about.map(item => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    </div>
  </section>

  {siteConfig.profile.codingStats.enabled && (
    <section
      class="mx-auto max-w-[1024px] text-center"
      aria-labelledby="coding-stats-title"
    >
      <h2 id="coding-stats-title" class="mb-4 text-xl font-semibold">
        {siteConfig.profile.codingStats.title}
      </h2>
      <object
        title={siteConfig.profile.codingStats.title}
        type="image/svg+xml"
        data={siteConfig.profile.codingStats.embedUrl}
        class="mx-auto min-h-64 w-full max-w-3xl"
      >
        <a href={siteConfig.profile.codingStats.profileUrl}>
          {siteConfig.profile.codingStats.fallbackText}
        </a>
      </object>
    </section>
  )}
</SiteLayout>
