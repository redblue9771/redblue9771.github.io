---
interface TocItem {
  slug: string
  text: string
  children: TocItem[]
}

interface Props {
  items: TocItem[]
}

const { items } = Astro.props
---

<ul class="space-y-1 border-s border-slate-300 pl-3 dark:border-slate-700">
  {items.map(item => (
    <li class="min-w-0">
      <a
        href={`#${item.slug}`}
        data-toc-link
        class="block break-words border-s-2 border-transparent py-0.5 pl-2 text-slate-700 no-underline hover:text-primary dark:text-slate-300 dark:hover:text-blue-300"
      >
        {item.text}
      </a>
      {item.children.length > 0 && <Astro.self items={item.children} />}
    </li>
  ))}
</ul>
